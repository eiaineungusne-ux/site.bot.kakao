{
  "name": "ventabot-status",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://kakaobot.xyz,https://www.kakaobot.xyz,https://venta.kakaobot.xyz"
  },
  "durable_objects": { "bindings": [{ "name": "STATUS", "class_name": "BotStatus" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotStatus"] }],
  "routes": [{ "pattern": "venta.kakaobot.xyz", "custom_domain": true }]
}
